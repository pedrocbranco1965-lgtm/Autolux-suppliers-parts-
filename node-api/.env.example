# AutoLux - API de fornecedores e encomendas
# Modelo para desenvolvimento local com MAMP.
# Numa nova instalacao, copiar para .env e ajustar os valores.
# Nao substituir um .env local que ja esteja configurado.

# Servidor Node: manter limitado ao computador local.
HOST=127.0.0.1
PORT=3000

# Segunda base de dados: fornecedores e encomendas.
# root/root sao valores de exemplo para MAMP local.
DB_HOST=127.0.0.1
DB_PORT=8889
DB_USER=root
DB_PASSWORD=root
DB_NAME=autolux_procurement_db

# JWT: utilizar a chave publica gerada para esta instalacao.
# No .env local, substituir SEU_UTILIZADOR pelo utilizador do Mac.
# Nao colocar aqui a chave privada nem o conteudo dos ficheiros PEM.
JWT_PUBLIC_KEY_PATH="/Users/SEU_UTILIZADOR/autolux-secrets/jwt/jwt-public.pem"
JWT_ISSUER=autolux-php
JWT_AUDIENCE=autolux-pecas

# Endpoint PHP que confirma conta ativa e token nao revogado.
AUTH_STATUS_URL=http://127.0.0.1:8888/AutoLux/php-app/public/auth-status.php

