Options -Indexes
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule (^|/)\. - [F,L]
    RewriteRule ^(?:node-api|sql|docs|frontend|tests)(?:/|$) - [F,L,NC]
    RewriteRule ^php-app/(?:config|classes|services|partials|tools)(?:/|$) - [F,L,NC]
</IfModule>
