# Nao apresentar listagens automaticas de pastas.
Options -Indexes

# Impedir acesso a ficheiros cujo nome comeca por ponto.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Este projeto exige mod_rewrite ativo no Apache.
RewriteEngine On

# Impedir acesso a ficheiros e pastas ocultos, incluindo .env e .git.
RewriteRule (^|/)\. - [F,L]

# Estas pastas nao devem ser disponibilizadas pelo Apache.
RewriteRule ^(?:node-api|sql|docs|frontend|tests)(?:/|$) - [F,L,NC]

# Bloquear o acesso HTTP direto ao codigo e bibliotecas internos do PHP.
RewriteRule ^php-app/(?:config|classes|services|partials|tools|middleware|vendor)(?:/|$) - [F,L,NC]

# Bloquear o acesso HTTP aos ficheiros de dependencias PHP.
RewriteRule ^php-app/composer\.(?:json|lock)(?:/|$) - [F,L,NC]

